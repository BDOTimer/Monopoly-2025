<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Visualizator-sfml" />
		<Option pch_mode="2" />
		<Option compiler="gcc-14-ucrt-64" />
		<Option virtualFolders="vsl/;vsl/sceneGame/;model-25/;model-25/controller/;model-25/model/;model-25/vsl/;model-25/model/implants/;imgui/;imgui/sfml/;res/" />
		<Build>
			<Target title="Release">
				<Option output="../../../bin/Visualizator/sfml-Visualizator[mingw]" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../../../bin/Visualizator" />
				<Option object_output="obj/" />
				<Option type="1" />
				<Option compiler="gcc-mingw64" />
				<Option use_console_runner="0" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++20" />
					<Add option="-DSFML_STATIC" />
					<Add directory="../../../extLibs/SFML-3.0.0[mingw64-ucrt]/include" />
					<Add directory="../../../extLibs/imgui-sfml-3.0" />
					<Add directory="../../../extLibs/imgui-1.91.8" />
					<Add directory="../../../Sources/Model-25" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-static" />
					<Add library="../../../extLibs/imgui-sfml-3.0/64/libImGui-SFML.a" />
					<Add library="sfml-graphics-s" />
					<Add library="sfml-window-s" />
					<Add library="libsfml-audio-s.a" />
					<Add library="libfreetype.a" />
					<Add library="libsfml-main-s.a" />
					<Add library="libgdi32.a" />
					<Add library="libwinmm.a" />
					<Add library="libopengl32.a" />
					<Add library="sfml-system-s" />
					<Add library="libFLAC.a" />
					<Add library="libvorbisenc.a" />
					<Add library="libvorbisfile.a" />
					<Add library="libvorbis.a" />
					<Add library="libogg.a" />
					<Add library="../../../extLibs/SFML-3.0.0[mingw64-ucrt]/lib/libwinmm.a" />
					<Add directory="../../../extLibs/SFML-3.0.0[mingw64-ucrt]/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-DSFML_STATIC" />
			<Add directory="$(#sfml30)/include" />
		</Compiler>
		<Linker>
			<Add library="mingw32" />
			<Add library="user32" />
			<Add library="gdi32" />
			<Add library="winmm" />
			<Add library="dxguid" />
			<Add directory="$(#sfml30)/lib" />
		</Linker>
